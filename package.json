{
  "name": "dsh-model-bridge",
  "description": "DeepSeek Harness plugin: exposes dsh models and one-shot agents to any MCP client agent (ZCode, Claude Code, Cursor, ...)",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-model-bridge-mcp": "lib/stdio.js"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "install:dsh": "node scripts/install-into-dsh.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mcp-server",
    "agent"
  ],
  "license": "MIT",
